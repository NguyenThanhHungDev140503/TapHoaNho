# ============================================
# Production Environment Variables
# ============================================
# File này chứa các biến môi trường cho môi trường production
# Vite sẽ tự động load file này khi chạy `npm run build`

# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Production: Thay đổi URL này thành domain production thực tế
# Lưu ý: Backend không có versioning (/v1), chỉ dùng /api
VITE_API_BASE_URL=https://api.storemanagement.com

# ============================================
# OIDC / DPoP Configuration
# ============================================

# Duende IdentityServer authority URL
VITE_IDENTITY_SERVER_AUTHORITY=https://identity.storemanagement.com

# OIDC client ID (must match Config.cs)
VITE_OIDC_CLIENT_ID=react-dpop

# Redirect URI after login (must be in Client.RedirectUris)
VITE_OIDC_REDIRECT_URI=https://storemanagement.com/callback

# Post-logout redirect URI
VITE_OIDC_POST_LOGOUT_URI=https://storemanagement.com

# ============================================
# Application Configuration
# ============================================

# Application Name
VITE_APP_NAME=Tap Hoa Nho

# Application Version
VITE_APP_VERSION=1.0.0

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable/Disable debug mode (nên tắt trong production)
# VITE_DEBUG=false

# Enable/Disable API request logging (nên tắt trong production)
# VITE_ENABLE_API_LOGGING=false
