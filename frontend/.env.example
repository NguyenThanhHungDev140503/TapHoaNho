# ============================================
# Environment Variables Example
# ============================================
# Copy file này thành .env.development hoặc .env.production
# và điền các giá trị phù hợp

# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Development: http://localhost:5175
# Production: https://your-production-domain.com
VITE_API_BASE_URL=http://localhost:5175

# ============================================
# OIDC / DPoP Configuration
# ============================================

# Duende IdentityServer authority URL
# Development: https://localhost:5001
VITE_IDENTITY_SERVER_AUTHORITY=https://localhost:5001

# OIDC client ID (must match IdentityServer Config.cs → react-dpop)
VITE_OIDC_CLIENT_ID=react-dpop

# Redirect URI after login (must be in Client.RedirectUris in Config.cs)
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# Post-logout redirect URI (must be in Client.PostLogoutRedirectUris)
VITE_OIDC_POST_LOGOUT_URI=http://localhost:5173

# ============================================
# Application Configuration
# ============================================

# Application Name
VITE_APP_NAME=Tap Hoa Nho

# Application Version
VITE_APP_VERSION=1.0.0

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable/Disable debug mode
# VITE_DEBUG=false

# Enable/Disable API request logging
# VITE_ENABLE_API_LOGGING=false
