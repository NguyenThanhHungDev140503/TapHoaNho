# ============================================
# TapHoaNho - Environment Secrets Template
# ============================================
# Copy file này thành .env.secrets và điền giá trị:
#   cp .env.secrets.example .env.secrets
# ============================================

# .NET Backend Environment Variables
# ============================================
ASPNETCORE_ENVIRONMENT=Development

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information

# Database (Neon PostgreSQL) — dùng chung cho WebApi + IdentityServer
ConnectionStrings__DefaultConnection=

# IdentityServer Signing Credential
# ============================================
# Development: KHÔNG cần cấu hình — AddDeveloperSigningCredential() tự tạo key tạm
# Production: PHẢI cấu hình — cần file certificate PKCS12 (.p12)
#
# Tạo certificate tự ký (development/testing):
#   openssl req -x509 -newkey ec:secp384r1 -keyout key.pem -out cert.pem -days 365 -nodes
#   openssl pkcs12 -export -out identityserver.p12 -inkey key.pem -in cert.pem -password pass:your-password
#   rm key.pem cert.pem
#
# Production: NÊN dùng certificate từ CA (Let's Encrypt, DigiCert, etc.)
# Lưu file .p12 ở đường dẫn an toàn (ví dụ: /etc/ssl/certs/identityserver.p12)
# ============================================
# IdentityServer__SigningCredential__KeyPath=/path/to/identityserver.p12
# IdentityServer__SigningCredential__Password=your-password

# Redis (optional, DPoP replay cache. Dev fallback to in-memory)
# Redis__ConnectionString=

# ImageKit
ImageKit__PublicKey=
ImageKit__PrivateKey=
ImageKit__UrlEndpoint=

# ============================================
# React/Vite Frontend Environment Variables
# ============================================
VITE_API_BASE_URL=http://localhost:5175
VITE_APP_NAME=Tap Hoa Nho
VITE_APP_VERSION=1.0.0
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
